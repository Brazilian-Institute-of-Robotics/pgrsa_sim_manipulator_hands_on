<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="fixed_r6bot">

  <xacro:include filename="$(find r6bot_description)/urdf/r6bot_manipulator.urdf.xacro"/>

  <!-- Create link fixed to the "world" -->
  <link name="world"/>

  <joint name="r6bot_fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0" rpy="0 0 0"/>
  </joint>


</robot>
