<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="mesa">
    <static>true</static>

    <!-- Tampa da mesa -->
    <link name="tampo">
      <pose>0 0 0.75 0 0 0</pose>

      <visual name="visual_tampo">
        <geometry>
          <box>
            <size>1.2 0.7 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.4 0.2 1</ambient>
          <diffuse>0.6 0.4 0.2 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="colisao_tampo">
        <geometry>
          <box>
            <size>1.2 0.7 0.05</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.43</ixx>
          <iyy>1.24</iyy>
          <izz>1.65</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- Perna dianteira esquerda -->
    <link name="perna_DE">
      <pose>-0.55 -0.30 0.35 0 0 0</pose>

      <visual name="visual_perna_DE">
        <geometry>
          <box>
            <size>0.05 0.05 0.72</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.3 0.15 1</ambient>
          <diffuse>0.5 0.3 0.15 1</diffuse>
        </material>
      </visual>

      <collision name="colisao_perna_DE">
        <geometry>
          <box>
            <size>0.05 0.05 0.72</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.065</ixx>
          <iyy>0.065</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Perna dianteira direita -->
    <link name="perna_DD">
      <pose>-0.55 0.30 0.35 0 0 0</pose>

      <visual name="visual_perna_DD">
        <geometry>
          <box>
            <size>0.05 0.05 0.72</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.3 0.15 1</ambient>
          <diffuse>0.5 0.3 0.15 1</diffuse>
        </material>
      </visual>

      <collision name="colisao_perna_DD">
        <geometry>
          <box>
            <size>0.05 0.05 0.72</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.065</ixx>
          <iyy>0.065</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Perna traseira esquerda -->
    <link name="perna_TE">
      <pose>0.55 -0.30 0.35 0 0 0</pose>

      <visual name="visual_perna_TE">
        <geometry>
          <box>
            <size>0.05 0.05 0.72</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.3 0.15 1</ambient>
          <diffuse>0.5 0.3 0.15 1</diffuse>
        </material>
      </visual>

      <collision name="colisao_perna_TE">
        <geometry>
          <box>
            <size>0.05 0.05 0.72</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.065</ixx>
          <iyy>0.065</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Perna traseira direita -->
    <link name="perna_TD">
      <pose>0.55 0.30 0.35 0 0 0</pose>

      <visual name="visual_perna_TD">
        <geometry>
          <box>
            <size>0.05 0.05 0.72</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.3 0.15 1</ambient>
          <diffuse>0.5 0.3 0.15 1</diffuse>
        </material>
      </visual>

      <collision name="colisao_perna_TD">
        <geometry>
          <box>
            <size>0.05 0.05 0.72</size>
          </box>
        </geometry>
      </collision>

      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.065</ixx>
          <iyy>0.065</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Junções fixas entre tampo e pernas -->
    <joint name="junta_perna_DE" type="fixed">
      <parent>tampo</parent>
      <child>perna_DE</child>
    </joint>

    <joint name="junta_perna_DD" type="fixed">
      <parent>tampo</parent>
      <child>perna_DD</child>
    </joint>

    <joint name="junta_perna_TE" type="fixed">
      <parent>tampo</parent>
      <child>perna_TE</child>
    </joint>

    <joint name="junta_perna_TD" type="fixed">
      <parent>tampo</parent>
      <child>perna_TD</child>
    </joint>

  </model>
</sdf>
