<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="cadeira">
    <static>true</static>

    <!-- Assento -->
    <link name="assento">
      <pose>0 0 0.45 0 0 0</pose>

      <visual name="visual_assento">
        <geometry>
          <box>
            <size>0.45 0.45 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.2 0.1 1</ambient>
          <diffuse>0.3 0.2 0.1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <collision name="colisao_assento">
        <geometry>
          <box>
            <size>0.45 0.45 0.04</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.051</ixx>
          <iyy>0.051</iyy>
          <izz>0.101</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Encosto -->
    <link name="encosto">
      <pose>0.20 0 0.70 0 0 0</pose>

      <visual name="visual_encosto">
        <geometry>
          <box>
            <size>0.04 0.45 0.50</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.2 0.1 1</ambient>
          <diffuse>0.3 0.2 0.1 1</diffuse>
        </material>
      </visual>

      <collision name="colisao_encosto">
        <geometry>
          <box>
            <size>0.04 0.45 0.50</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.043</ixx>
          <iyy>0.003</iyy>
          <izz>0.043</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Perna dianteira esquerda -->
    <link name="perna_DE">
      <pose>-0.19 -0.19 0.22 0 0 0</pose>

      <visual name="visual_perna_DE">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.44</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.13 0.07 1</ambient>
          <diffuse>0.2 0.13 0.07 1</diffuse>
        </material>
      </visual>

      <collision name="colisao_perna_DE">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.44</length>
          </cylinder>
        </geometry>
      </collision>

      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.010</ixx>
          <iyy>0.010</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Perna dianteira direita -->
    <link name="perna_DD">
      <pose>-0.19 0.19 0.22 0 0 0</pose>

      <visual name="visual_perna_DD">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.44</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.13 0.07 1</ambient>
          <diffuse>0.2 0.13 0.07 1</diffuse>
        </material>
      </visual>

      <collision name="colisao_perna_DD">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.44</length>
          </cylinder>
        </geometry>
      </collision>

      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.010</ixx>
          <iyy>0.010</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Perna traseira esquerda (estendida para suportar encosto) -->
    <link name="perna_TE">
      <pose>0.19 -0.19 0.47 0 0 0</pose>

      <visual name="visual_perna_TE">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.95</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.13 0.07 1</ambient>
          <diffuse>0.2 0.13 0.07 1</diffuse>
        </material>
      </visual>

      <collision name="colisao_perna_TE">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.95</length>
          </cylinder>
        </geometry>
      </collision>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.075</ixx>
          <iyy>0.075</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Perna traseira direita (estendida para suportar encosto) -->
    <link name="perna_TD">
      <pose>0.19 0.19 0.47 0 0 0</pose>

      <visual name="visual_perna_TD">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.95</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.13 0.07 1</ambient>
          <diffuse>0.2 0.13 0.07 1</diffuse>
        </material>
      </visual>

      <collision name="colisao_perna_TD">
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.95</length>
          </cylinder>
        </geometry>
      </collision>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.075</ixx>
          <iyy>0.075</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Junções fixas -->
    <joint name="junta_encosto" type="fixed">
      <parent>assento</parent>
      <child>encosto</child>
    </joint>

    <joint name="junta_perna_DE" type="fixed">
      <parent>assento</parent>
      <child>perna_DE</child>
    </joint>

    <joint name="junta_perna_DD" type="fixed">
      <parent>assento</parent>
      <child>perna_DD</child>
    </joint>

    <joint name="junta_perna_TE" type="fixed">
      <parent>assento</parent>
      <child>perna_TE</child>
    </joint>

    <joint name="junta_perna_TD" type="fixed">
      <parent>assento</parent>
      <child>perna_TD</child>
    </joint>

  </model>
</sdf>
