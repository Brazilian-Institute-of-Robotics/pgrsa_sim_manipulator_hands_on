<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="bola">
    <static>false</static>

    <link name="corpo">
      <pose>0 0 0.12 0 0 0</pose>

      <velocity_decay>
        <linear>0.002</linear>
        <angular>0.005</angular>
      </velocity_decay>

      <visual name="visual_bola">
        <geometry>
          <sphere>
            <radius>0.12</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.9 0.1 0.1 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <emissive>0.0 0.0 0.0 1</emissive>
        </material>
      </visual>

      <collision name="colisao_bola">
        <geometry>
          <sphere>
            <radius>0.12</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.7</mu>
              <mu2>0.7</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e5</kp>
              <kd>10.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <bounce>
            <restitution_coefficient>0.7</restitution_coefficient>
            <threshold>0.5</threshold>
          </bounce>
        </surface>
      </collision>

      <!-- I = 2/5 * m * r² = 2/5 * 0.45 * 0.0144 = 0.002592 kg·m² -->
      <inertial>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.002592</ixx>
          <iyy>0.002592</iyy>
          <izz>0.002592</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

    </link>

  </model>
</sdf>
