<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="r6bot_gripper">

  <!--
    Gripper paralelo de 2 dedos para o r6bot (Example 7 - ros2_control_demos).
    Projetado para manipular a bola SDF (raio = 0.12 m).

    Estrutura:
      tool0  (flange do r6bot)
        └─ gripper_base       [link fixo ao tool0]
             ├─ finger_left   [prismático, desliza em Y+]
             └─ finger_right  [prismático, desliza em Y-]

    A abertura máxima (0.28 m) é maior que o diâmetro da bola (0.24 m).
    O fechamento segura a bola com fricção estática suficiente.
  -->

  <!-- ════════════════════════════════════════════════════
       PARÂMETROS GEOMÉTRICOS
       ════════════════════════════════════════════════════ -->
  <xacro:property name="base_length"   value="0.08"/>
  <xacro:property name="base_width"    value="0.10"/>
  <xacro:property name="base_height"   value="0.04"/>

  <xacro:property name="finger_length" value="0.10"/>
  <xacro:property name="finger_width"  value="0.02"/>
  <xacro:property name="finger_height" value="0.04"/>

  <!-- abertura máxima / 2  (bola tem raio 0.12 → precisa de pelo menos 0.13) -->
  <xacro:property name="finger_max_open"  value="0.14"/>
  <!-- fechamento mínimo (metade da espessura do dedo) -->
  <xacro:property name="finger_min_open"  value="0.01"/>

  <!-- massa -->
  <xacro:property name="base_mass"   value="0.3"/>
  <xacro:property name="finger_mass" value="0.05"/>

  <!-- ════════════════════════════════════════════════════
       MACRO de INÉRCIA
       ════════════════════════════════════════════════════ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
        iyy="${m*(x*x+z*z)/12}" iyz="0"
        izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- ════════════════════════════════════════════════════
       LINKS
       ════════════════════════════════════════════════════ -->

  <!-- Base do gripper -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}"
                       x="${base_length}"
                       y="${base_width}"
                       z="${base_height}"/>
  </link>

  <!-- Dedo esquerdo (se move em +Y) -->
  <link name="finger_left">
    <visual>
      <origin xyz="${finger_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${finger_length} ${finger_width} ${finger_height}"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.5 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${finger_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${finger_length} ${finger_width} ${finger_height}"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.2</mu>
            <mu2>1.2</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <xacro:box_inertia m="${finger_mass}"
                       x="${finger_length}"
                       y="${finger_width}"
                       z="${finger_height}"/>
  </link>

  <!-- Dedo direito (se move em -Y) -->
  <link name="finger_right">
    <visual>
      <origin xyz="${finger_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${finger_length} ${finger_width} ${finger_height}"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.5 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${finger_length/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${finger_length} ${finger_width} ${finger_height}"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.2</mu>
            <mu2>1.2</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <xacro:box_inertia m="${finger_mass}"
                       x="${finger_length}"
                       y="${finger_width}"
                       z="${finger_height}"/>
  </link>

  <!-- ════════════════════════════════════════════════════
       JOINTS
       ════════════════════════════════════════════════════ -->

  <!-- Fixa o gripper ao flange do r6bot -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="tool0"/>
    <child  link="gripper_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Junta prismática: dedo esquerdo (eixo +Y) -->
  <joint name="gripper_finger_left_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child  link="finger_left"/>
    <!-- origem na face lateral, centralizada em Z -->
    <origin xyz="0 ${base_width/2} ${base_height/2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${finger_min_open}"
           upper="${finger_max_open}"
           effort="20.0"
           velocity="0.1"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Junta prismática: dedo direito (eixo -Y) -->
  <joint name="gripper_finger_right_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child  link="finger_right"/>
    <origin xyz="0 ${-base_width/2} ${base_height/2}" rpy="0 0 ${pi}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${finger_min_open}"
           upper="${finger_max_open}"
           effort="20.0"
           velocity="0.1"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- ════════════════════════════════════════════════════
       ros2_control TAG
       ════════════════════════════════════════════════════ -->
  <ros2_control name="r6bot_gripper_hardware" type="system">
    <hardware>
      <!-- Plugin de simulação (mock) — troque pelo driver real em hardware físico -->
      <plugin>r6bot_gripper/GripperHardwareInterface</plugin>
      <!-- Parâmetros opcionais do driver -->
      <param name="loop_rate">50</param>
      <param name="ball_radius">0.12</param>
    </hardware>

    <!-- Junta esquerda -->
    <joint name="gripper_finger_left_joint">
      <command_interface name="position">
        <param name="min">0.01</param>
        <param name="max">0.14</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.14</param>   <!-- começa aberto -->
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Junta direita (espelhada, controlada em conjunto) -->
    <joint name="gripper_finger_right_joint">
      <command_interface name="position">
        <param name="min">0.01</param>
        <param name="max">0.14</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.14</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

  </ros2_control>

</robot>
